{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Waterball",
  "version": "0.1.13",
  "identifier": "com.waterball.bbs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splashscreen",
        "title": "Waterball",
        "url": "splash.html",
        "width": 360,
        "height": 260,
        "center": true,
        "decorations": false,
        "resizable": false,
        "visible": true,
        "shadow": true,
        "backgroundColor": "#0d1117"
      },
      {
        "label": "main",
        "title": "Waterball",
        "width": 900,
        "height": 650,
        "minWidth": 360,
        "minHeight": 360,
        "decorations": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https:; font-src 'self' data:; object-src 'none'; base-uri 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
